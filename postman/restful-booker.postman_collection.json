    {
      "name": "Booking",
      "description": "A full create-read-update-delete cycle. With bookings.csv the whole cycle runs once per row.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Built here rather than in the raw body so additionalneeds can be left out entirely",
              "// when the data file has no value for it.",
              "const booking = {",
              "  firstname: pm.variables.get('firstname'),",
              "  lastname: pm.variables.get('lastname'),",
              "  totalprice: Number(pm.variables.get('totalprice')),",
              "  depositpaid: pm.variables.get('depositpaid') === 'true',",
              "  bookingdates: {",
              "    checkin: pm.variables.get('checkin'),",
              "    checkout: pm.variables.get('checkout'),",
              "  },",
              "};",
              "",
              "const extras = pm.variables.get('additionalneeds');",
              "if (extras) {",
              "  booking.additionalneeds = extras;",
              "}",
              "",
              "pm.collectionVariables.set('booking', JSON.stringify(booking));"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('bookingid', pm.response.json().bookingid);",
                  "",
                  "const sent = JSON.parse(pm.collectionVariables.get('booking'));",
                  "const schema = JSON.parse(pm.collectionVariables.get('createdBookingSchema'));",
                  "",
                  "// Postman has no schema registry, so the one $ref is resolved here.",
                  "schema.properties.booking = JSON.parse(pm.collectionVariables.get('bookingSchema'));",
                  "",
                  "pm.test('responds 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('matches the created booking schema', function () {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('echoes the booking that was sent', function () {",
                  "  pm.expect(pm.response.json().booking).to.eql(sent);",
                  "});",
                  "",
                  "pm.test('responds within the budget', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(",
                  "    Number(pm.environment.get('responseBudgetMs')),",
                  "  );",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{booking}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "description": "Creates the booking described by the current data row."
          }
        },
        {
          "name": "Get booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sent = JSON.parse(pm.collectionVariables.get('booking'));",
                  "const schema = JSON.parse(pm.collectionVariables.get('bookingSchema'));",
                  "",
                  "pm.test('responds 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('matches the booking schema', function () {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('returns the booking that was created', function () {",
                  "  pm.expect(pm.response.json()).to.eql(sent);",
                  "});",
                  "",
                  "pm.test('responds within the budget', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(",
                  "    Number(pm.environment.get('responseBudgetMs')),",
                  "  );",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingid}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingid}}"
              ]
            }
          }
        },
