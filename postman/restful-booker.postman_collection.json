              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const booking = JSON.parse(pm.collectionVariables.get('booking'));",
                  "booking.totalprice = 450;",
                  "booking.depositpaid = false;",
                  "",
                  "pm.collectionVariables.set('updatedBooking', JSON.stringify(booking));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sent = JSON.parse(pm.collectionVariables.get('updatedBooking'));",
                  "const schema = JSON.parse(pm.collectionVariables.get('bookingSchema'));",
                  "",
                  "pm.test('responds 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('matches the booking schema', function () {",
                  "  pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('returns the updated booking', function () {",
                  "  pm.expect(pm.response.json()).to.eql(sent);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
