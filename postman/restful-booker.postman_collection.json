      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('responds in plain text', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/plain');",
                  "});",
                  "",
                  "pm.test('responds within the budget', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(",
                  "    Number(pm.environment.get('responseBudgetMs')),",
                  "  );",
                  "});"
                ]
              }
            }
          ],
