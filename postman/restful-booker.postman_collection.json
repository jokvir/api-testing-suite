{
  "info": {
    "_postman_id": "2337f1a5-fe2a-4b4d-b970-3a8597b15651",
    "name": "Restful Booker",
    "description": "Exploratory and regression checks for the Restful Booker API. The base URL and the credentials come from the environment, so the same collection runs against the local container and the public instance. Run it with the bookings.csv data file to exercise several payloads in one go.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// One token per run, fetched lazily so any request can also be sent on its own.",
          "if (!pm.collectionVariables.get('token')) {",
          "  pm.sendRequest(",
          "    {",
          "      url: pm.environment.get('baseUrl') + '/auth',",
          "      method: 'POST',",
          "      header: { 'Content-Type': 'application/json' },",
          "      body: {",
          "        mode: 'raw',",
          "        raw: JSON.stringify({",
          "          username: pm.environment.get('username'),",
          "          password: pm.environment.get('password'),",
          "        }),",
          "      },",
          "    },",
          "    function (error, response) {",
          "      if (error) { throw error; }",
          "      pm.collectionVariables.set('token', response.json().token);",
          "    },",
          "  );",
          "}"
        ]
      }
    }
  ],
